# LCKED — Environment Variables
# ============================================================
# Copy this file to `.env` (local dev) or set these in your Render
# dashboard (production). All variables are OPTIONAL — the app works
# fully offline without any of them. They're only needed for optional
# cloud sync via Firebase.

# --- OPTIONAL: Google OAuth (cloud sync identity) ----------------
# Create at: https://console.cloud.google.com/apis/credentials
# Add your Render URL to "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- OPTIONAL: Firebase service account (cloud sync backend) -----
# Paste the ENTIRE JSON key from:
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Must be a single line (minified JSON). The server parses it at runtime.
FIREBASE_SERVICE_ACCOUNT=

# --- AUTO-SET by Render (don't set manually) ---------------------
# PORT — Render sets this automatically. The standalone server listens on it.
# NODE_ENV — Render sets this to "production" automatically.
